# /etc/tongjun-overseas.env
# chmod 600; never commit real values.
TONGJUN_API_HOST=127.0.0.1
TONGJUN_API_PORT=8787
TONGJUN_DEPLOYMENT_ENVIRONMENT=production

# ---------------------------------------------------------------- RFQ mail delivery
# Buyer submission -> /api/rfq -> mail transport -> mailbox. There is no webhook hop;
# the Node service sends the message itself through the transport selected below.
#
# Transport: graph | smtp | resend | log
#   graph   Microsoft Graph. Needs a Microsoft 365 work/school mailbox (application
#           permissions) OR a refresh token (delegated, the only mode personal
#           @outlook.com accounts support).
#   smtp    Any relay, port 465 implicit TLS or 587 STARTTLS.
#   resend  Resend HTTP API. Sender must be on a domain you have verified.
#   log     Local-only. Delivers nothing and can never mark production ready.
RFQ_MAIL_TRANSPORT=

# Recipient mailbox. Comma-separate for more than one.
RFQ_MAIL_TO=wuxi304@outlook.com

# Sender address. Must be a mailbox the transport is allowed to send as.
# For resend this must be on a verified domain, e.g. rfq@exoticalloycn.com
RFQ_MAIL_FROM=
RFQ_MAIL_FROM_NAME=Tongjun RFQ Desk

# Reply-To is set to the buyer's submitted address so "Reply" answers the customer.
# Set to 0 to disable that behaviour.
RFQ_MAIL_REPLY_TO_CUSTOMER=1

# --- Microsoft Graph ---
# Application mode (work/school tenant): tenant + client + secret.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Delegated mode: set MS_GRAPH_REFRESH_TOKEN instead of the tenant/secret above.
# Personal @outlook.com accounts must use this mode; MS_GRAPH_TENANT_ID defaults to
# "common" because personal accounts cannot authenticate against a tenant id.
MS_GRAPH_REFRESH_TOKEN=

# --- SMTP ---
RFQ_SMTP_HOST=
RFQ_SMTP_PORT=465
RFQ_SMTP_SECURE=1
RFQ_SMTP_USER=
RFQ_SMTP_PASS=
# RFQ_SMTP_STARTTLS=1
# RFQ_SMTP_HELO=exoticalloycn.com
# Plaintext SMTP is refused outside loopback; this switch only exists for local tests.
# RFQ_SMTP_ALLOW_PLAINTEXT=0

# --- Resend ---
RESEND_API_KEY=
# Only for a deliberately unverified sender (local testing).
# RFQ_RESEND_ALLOW_UNVERIFIED_DOMAIN=0

# ------------------------------------------------------------------- RFQ ledger
# One JSON line per submission: request_id / timestamps / status / message_id /
# company / email / country / grade / form / error. The inquiry body is never stored.
RFQ_LEDGER_PATH=/var/lib/tongjun-rfq/rfq-ledger.jsonl
# RFQ_LEDGER_DISABLED=1

RFQ_ALLOWED_ORIGINS=https://exoticalloycn.com,https://www.exoticalloycn.com
